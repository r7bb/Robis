{
  "name": "robis",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/*",
    "shared/*"
  ],
  "scripts": {
    "postinstall": "bun run scripts/db/fix-pg-dylibs.ts",
    "//dev": "Run from the repository root, not via --filter: Bun loads .env from the working directory, and --filter would start each service in its own package directory where there is none.",
    "dev:api": "NODE_ENV=development bun --watch backend/api/src/main.ts",
    "dev:realtime": "NODE_ENV=development bun --watch backend/realtime/src/main.ts",
    "dev:worker": "NODE_ENV=development bun --watch backend/worker/src/main.ts",
    "dev:web": "bun --filter '@robis/web' dev",
    "start:api": "bun backend/api/src/main.ts",
    "db:start": "bun run scripts/db/dev-db.ts start",
    "db:stop": "bun run scripts/db/dev-db.ts stop",
    "db:reset": "bun run scripts/db/dev-db.ts reset",
    "db:migrate": "bun run scripts/db/migrate.ts",
    "db:roles": "bun backend/database/src/roles-cli.ts",
    "audit:seal": "bun backend/database/src/audit-seal-cli.ts",
    "audit:erase": "bun backend/database/src/audit-erase-cli.ts",
    "db:seed": "NODE_ENV=development bun run scripts/db/seed.ts",
    "db:push": "bun --filter '@robis/database' push",
    "grant:owner": "bun run scripts/db/grant-owner.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p shared/contracts && tsc --noEmit -p shared/sync && tsc --noEmit -p backend/metrics && tsc --noEmit -p backend/mailer && tsc --noEmit -p backend/auth && tsc --noEmit -p backend/database && tsc --noEmit -p backend/api && tsc --noEmit -p backend/realtime && tsc --noEmit -p backend/worker && tsc --noEmit -p scripts && tsc --noEmit -p frontend",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docs:links": "bun run scripts/docs/links.ts",
    "loadtest": "bun run scripts/bench/loadtest.ts",
    "screenshots": "bun run scripts/capture/screenshots.ts",
    "mail:start": "bun run scripts/mail/sink.ts",
    "smoke:stack": "bun run scripts/smoke/stack.ts",
    "smoke:browser": "bun run scripts/smoke/browser.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@robis/api": "workspace:*",
    "@robis/auth": "workspace:*",
    "@robis/database": "workspace:*",
    "@robis/mailer": "workspace:*",
    "@robis/metrics": "workspace:*",
    "@robis/realtime": "workspace:*",
    "@robis/shared": "workspace:*",
    "@robis/sync": "workspace:*",
    "@robis/worker": "workspace:*",
    "@types/bun": "latest",
    "@types/smtp-server": "3.5.13",
    "drizzle-orm": "^0.38.0",
    "embedded-postgres": "18.4.0-beta.17",
    "fastify": "^5.2.0",
    "nodemailer": "10.0.12",
    "postgres": "^3.4.9",
    "sharp": "0.34.5",
    "smtp-server": "3.19.15",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yjs": "^13.6.32"
  }
}
