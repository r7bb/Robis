# The edge proxy's routes, imported by both Caddyfiles: one origin for the
# whole app (stage 1, item 3).
#
#   /api/*   the API, with the /api prefix taken off
#   /ws      the realtime gateway, WebSocket upgrade included
#   /mcp/*   the MCP server for agents, path kept (it names the workspace)
#   /        the web app

handle_path /api/* {
	reverse_proxy api:4000
}

# Exactly /ws: nothing else on the gateway (its health or metrics) is
# reachable through the proxy.
handle /ws {
	reverse_proxy realtime:4001
}

handle /mcp/* {
	reverse_proxy mcp:4002
}

# The web app sets a nonce policy on every page. Anything it serves without
# one (static files, a 404 for a file name) gets a policy that allows
# nothing, set only when none came back (E3). Not the service worker: a
# worker's policy comes from its own response, and this one would stop it
# fetching anything.
handle {
	@unpoliced not path /sw.js
	header @unpoliced ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	reverse_proxy web:3000
}
