# The edge proxy for the development stack: plain HTTP on 8080 inside the
# container, published on 127.0.0.1 only. The routes are in caddy-routes;
# Caddyfile.production serves the same routes over TLS, and a deployment
# replaces the address with its hostname (see docs/DEPLOY.md).
{
	admin off
	auto_https off
}

:8080 {
	import /etc/caddy/routes
}
